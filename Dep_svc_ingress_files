apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-deployment
  labels:
    app: redlabel

spec:
  replicas: 5

  selector:
    matchLabels:
      app: redlabel

  template:
    metadata:
      labels:
        app: redlabel

    spec:
      containers:
        - name: mycon1
          image: myimage
          ports:
            - containerPort: 80


---
apiVersion: v1
kind: Service
metadata:
  name: my-svc

spec:
  selector:
    app: redlabel

  ports:
    - protocol: TCP
      port: 80
      targetPort: 80

  type: LoadBalancer


---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: myingress

spec:
  ingressClassName: mying

  rules:
    - host: devopswithvaibhav.com
      http:
        paths:
          - path: /testpath
            pathType: Prefix
            backend:
              service:
                name: my-svc
                port:
                  number: 80
