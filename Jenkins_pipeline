Pipeline {
   agent any
  
   environment {
 
      AWS_REGION = 'us-east-1'ja
      AWS_ACCOUNT_ID = "123456789098'
      AWS_REPO_NAME = 'myapp'
      IMAGE_TAG ="${BUILD_NUMBER}"
      ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
   }
   
   stages {
   
       stage('1. checkout') {
         steps {
             git branch: 'main'
                url: 'https://vaibhavkadukar/xyz/my-project.git'
         }
       }
 
       stage('2. Unit test') {
         steps {
             sh 'npm install'
             sh 'npm test'
         }
       }

       stage('3. SonarQube scan') {
         steps {
             sh 'sonar-scanner'   
         }
       }

       stage('4. Docker Image Build') {
         steps {
             sh 'docker build -t ${ECR_REPO_NAME}:${IMAGE_TAG}'   
         }
       }

       stage('5. Docker Image Build') {
         steps {
             sh 'docker build -t ${ECR_REPO_NAME}:${IMAGE_TAG} .'   
         }
       }

       stage('6. Login to ECR') {
         steps {
OBOB             sh 'aws ecr get-login-password --region ${AWS_REGION} | docker login --/ 
OBOBOB                     username AWS --password-stdin ${ECR_REGISTRY}'   
         }
OBOBOB       }
OBOBOB
       stage('7. Push image to ECR') {
OBOBOB         steps {
OBOBOB           sh 'docker push ${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG}'    
OBOBOB           sh 'docker push ${ECR_REGISTRY}/${ECR_REPO_NAME}:latest
         }
       }

       stage('7. ') {
         steps {
           sh 'kubectl apply -f deployment.yml'    
           sh 'kubectl apply -f service.yml'
         }
       }
   }  

}
